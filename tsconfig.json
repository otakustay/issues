{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2024",
    "allowJs": false,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": false,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "dist"
  },
  "include": ["*.tsx"]
}
